    "macOS 不允许替换程序。到系统设置的隐私与安全性 → App 管理中允许后重试": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允许替换程序。到系统设置的隐私与安全性 → App 管理中允许后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS blocked app replacement. Allow it in System Settings → Privacy & Security → App Management, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 不允許替換程式。到系統設定的隱私權與安全性 → App 管理中允許後重試"
          }
        }
      }
    },
    "上次检查：%@": {
